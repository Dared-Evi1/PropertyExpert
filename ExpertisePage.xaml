<Page x:Class="Diplom.ExpertisePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Экспертизы" FontFamily="Montserrat" Loaded="Page_Loaded"
      Background="{StaticResource BackgroundColor}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" 
                Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Информация о пользователе -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Name="ima" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Name="role" FontSize="13" Foreground="Gray"/>
                </StackPanel>

                <!-- Центральная панель с фильтрами -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Поиск -->
                    <Border Background="#F5F5F5" CornerRadius="6" Padding="8,5" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍 " FontSize="16" VerticalAlignment="Center"/>
                            <TextBox Name="PoiskPoAdress" TextChanged="PoiskPoAdress_TextChanged"
                                     Width="250" FontSize="14" 
                                     Background="Transparent" BorderThickness="0"
                                     ToolTip="Введите адрес для поиска"/>
                        </StackPanel>
                    </Border>

                    <!-- Фильтр по комнатам -->
                    <Border Background="#F5F5F5" CornerRadius="6" Padding="8,5" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠 " FontSize="16" VerticalAlignment="Center"/>
                            <ComboBox Name="FiltrKomnat" Width="150" FontSize="14"
                                      SelectionChanged="FiltrKomnat_SelectionChanged"
                                      Background="Transparent" BorderThickness="0">
                                <ComboBoxItem>Все записи</ComboBoxItem>
                                <ComboBoxItem>1-комнатные</ComboBoxItem>
                                <ComboBoxItem>2-комнатные</ComboBoxItem>
                                <ComboBoxItem>3+ комнатные</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Сортировка -->
                    <!-- Сортировка -->
                    <Border Background="#F5F5F5" CornerRadius="6" Padding="8,5" Margin="5">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Сортировка. Дата начала" Foreground="#000000"/>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Name="New" Checked="New_Checked" Unchecked="New_Unchecked" 
                     Content="📅 Новые" Margin="8,0" FontSize="13"
                     Background="Transparent" BorderThickness="1" BorderBrush="#DDD"
                     Padding="8,3"/>
                                <ToggleButton Name="Old" Checked="Old_Checked" Unchecked="Old_Unchecked" 
                     Content="📅 Старые" Margin="8,0" FontSize="13"
                     Background="Transparent" BorderThickness="1" BorderBrush="#DDD"
                     Padding="8,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <StackPanel Orientation="Vertical" Grid.Column="2">
                    <!-- Кнопка добавления -->
                    <Button Name="Add" Click="Add_Click" Content="+ Новая экспертиза"
                         Background="{StaticResource SuccessColor}"
                        FontSize="14" Height="40" Width="140"/>
                    <Button Name="Cancel" Click="Cancel_Click" Content="Отмененные экспертизы"
                         Background="{StaticResource SuccessColor}"
                        FontSize="14" Height="40" />

                </StackPanel>
            </Grid>
        </Border>

        <!-- Список экспертиз с фиксированной высотой карточек -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ElementName=ExpertiseListView, Path=ItemsSource}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Фиксированная высота карточки - 170px для единообразия -->
                        <Border Background="White" CornerRadius="8" Padding="12" 
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                Height="170" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" Opacity="0.1" ShadowDepth="1"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Изображение -->
                                <Border CornerRadius="6" Background="#F5F5F5" 
                                        Width="170" Height="170"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" >
                                    <Image Source="{Binding RealtiesPhoto}" 
                                           Stretch="Uniform"/>
                                </Border>

                                <!-- Информация -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5">
                                    <TextBlock Text="{Binding Address1}" HorizontalAlignment="Left"
           FontSize="15" FontWeight="Bold"
           Foreground="#000000"
           TextTrimming="CharacterEllipsis"
           MaxWidth="700"/>

                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock FontSize="14" Margin="0,0,12,0" Foreground="#000000">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="📐 {0} м²">
                                                    <Binding Path="Area1"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock FontSize="14" Margin="0,0,12,0" Foreground="#000000">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="🏠 {0}-к">
                                                    <Binding Path="Purpose1"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock FontSize="14" Foreground="#000000">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="📍 {0}">
                                                    <Binding Path="Floor1"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </WrapPanel>

                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock FontSize="14" Foreground="#27AE60" Margin="0,0,15,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="💰 Экспертиза: {0:N0} ₽">
                                                    <Binding Path="Cost"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock FontSize="14" Foreground="#E67E22">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="🏷️ Объект: {0:N0} ₽">
                                                    <Binding Path="PriceRealties"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding ExpertisePeriod}" 
           FontSize="14" Foreground="#000000" 
           Margin="0,6,0,0"/>

                                    <TextBlock FontSize="14" Foreground="#000000" Margin="0,4,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="👤 {0}">
                                                <Binding Path="Expert"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Кнопки действий -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" 
                                            Margin="10,0,0,0" Width="125">
                                    <Button Name="Edit" Click="Edit_Click" Content="✏️Редактировать"
                                            Background="#3498DB" Height="30" FontSize="11" Margin="0,5,0,0"/>
                                    <Button Name="Delete" Click="Delete_Click" Content="🗑️ Удалить"
                                            Background="#E74C3C" Height="30" FontSize="11" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Скрытый ListView для привязки данных -->
        <ListView Name="ExpertiseListView" Grid.Row="1" Visibility="Collapsed"
                  IsVisibleChanged="ExpertiseListView_IsVisibleChanged"/>

        <!-- Нижняя панель только с счетчиком -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" 
                Padding="10" Margin="0,10,0,0">
            <TextBlock Name="Count" FontSize="12" Foreground="Gray"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>