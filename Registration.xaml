<Page x:Class="Diplom.Registrtion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Авторизация" FontFamily="Montserrat"
      Background="{StaticResource BackgroundColor}">

    <Grid>
        <!-- Центрируем содержимое по вертикали и горизонтали -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Карточка авторизации - увеличиваем размер для лучшего восприятия -->
        <Border Grid.Row="1" Width="550" HorizontalAlignment="Center"
                Background="White" CornerRadius="15"
                BorderBrush="{StaticResource PrimaryColor}" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.25" ShadowDepth="3"/>
            </Border.Effect>

            <StackPanel Margin="15">
                <!-- Заголовок -->
                <Image Source="Res/icon.png" Width="140" Height="140" HorizontalAlignment="Center"/>
                <TextBlock Text="Вход в систему" 
                           FontSize="28" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryColor}"
                           HorizontalAlignment="Center" Margin="10"/>

                <!-- Поле логина -->
                <TextBlock Text="Логин" FontSize="16" FontWeight="SemiBold" 
                           Foreground="{StaticResource PrimaryColor}" Margin="10"/>
                <TextBox Name="Login" FontSize="16" Height="42"
                         >
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                                                CornerRadius="8" Background="White">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="10"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Поле пароля -->
                <TextBlock Text="Пароль" FontSize="16" FontWeight="SemiBold" 
                           Foreground="{StaticResource PrimaryColor}" Margin="10"/>
                <PasswordBox Name="Password" FontSize="16" Height="42"
                         >
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                                                CornerRadius="8" Background="White">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="10"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <!-- Кнопки -->
                <Button Name="Welcome" Click="Welcome_Click" 
                        Content="Войти" Margin="10"
                        Background="{StaticResource SecondaryColor}"
                        FontSize="16" Height="45" Width="180"
                        HorizontalAlignment="Center"/>


                <!-- Дополнительная информация -->
                <TextBlock Text="Для входа используйте учетные данные, выданные администратором"
                           FontSize="11" Foreground="#7F8C8D" 
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="10"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>