<Window x:Class="Diplom.AddEditCase"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diplom"
        mc:Ignorable="d"
        Title="AddEditCase" Height="320" Width="500">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="{Binding Title}" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Номер дела -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Номер дела:" 
                   FontSize="16" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="1" Grid.Column="1" 
                 Name="NumberCaseTextBox" 
                 Text="{Binding Number_Case}" 
                 FontSize="16" Height="30" Margin="5"/>

        <!-- Дата дела -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Дата дела:" 
                   FontSize="16" VerticalAlignment="Center" Margin="5"/>
        <DatePicker Grid.Row="2" Grid.Column="1" 
                    Name="DateCasePicker" 
                    SelectedDate="{Binding Date_Case}" 
                    FontSize="16" Height="30" Margin="5"/>

        <!-- Суд -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Суд:" 
                   FontSize="16" VerticalAlignment="Center" Margin="5"/>
        <ComboBox Name="CourtComboBox" Grid.Row="3" Grid.Column="1" FontSize="16" Text="{Binding court}">
            <TextBlock Text="Арбитражный суд"></TextBlock>
            <TextBlock Text="Военный суд"></TextBlock>
            <TextBlock Text="Конституционный суд"></TextBlock>
        </ComboBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Сохранить" 
                    Name="SaveButton" 
                    Click="SaveButton_Click" 
                    Width="100" Height="35" Margin="5"
                    FontSize="14" IsDefault="True"/>
            <Button Content="Отмена" 
                    Name="CancelButton" 
                    Click="CancelButton_Click" 
                    Width="100" Height="35" Margin="5"
                    FontSize="14" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
