<Window x:Class="Diplom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diplom"
        mc:Ignorable="d"
        Title="Башкирская ЛСЭ Минюста России" 
        Height="700" Width="1000" 
        Icon="/Res/icon.png" FontFamily="Montserrat"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        
        <!-- Верхняя панель с логотипом и названием -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryColor}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                    <Image Source="Res/icon.png" Width="40" Height="40" Margin="5"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ФБУ Башкирская ЛСЭ Минюста России" 
                                   Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Судебно-экспертное учреждение" 
                                   Foreground="#BDC3C7" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="← Назад" Name="BtnBack" Click="BtnBack_Click"
                        Width="90" Height="30" HorizontalAlignment="Right" FontSize="18" Margin="5"/>

            </Grid>
        </Border>
        
        <!-- Основной контент -->
        <Frame Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" 
               ContentRendered="MainFrame_ContentRendered"/>
        
        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="#34495E">
            <Grid>
                <TextBlock Text="© 2026 ФБУ Башкирская ЛСЭ Минюста России" 
                           Foreground="#BDC3C7" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>