<Page x:Class="Diplom.DismissedExperts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom"
      mc:Ignorable="d" Loaded="Page_Loaded"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DismissedExperts">

    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" 
                 Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Информация о пользователе -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Name="ima" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Name="role" FontSize="13" Foreground="Gray"/>
                    </StackPanel>

                    <!-- Центральная панель с фильтрами -->
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Поиск -->
                        <Border Background="#F5F5F5" CornerRadius="6" Padding="8,5" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍 " FontSize="16" VerticalAlignment="Center"/>
                                <TextBox Name="PoiskPoFIO" TextChanged="PoiskPoFIO_TextChanged"
                                     Width="250" FontSize="14" 
                                     Background="Transparent" BorderThickness="0"
                                     ToolTip="Поиск по ФИО"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F5F5F5" CornerRadius="6" Padding="8,5" Margin="5">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Сортировка. Дата начала" Foreground="#000000"/>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Name="New" Checked="New_Checked" Unchecked="New_Unchecked" 
                     Content="🔤 От А до Я" Margin="8,0" FontSize="13"
                     Background="Transparent" BorderThickness="1" BorderBrush="#DDD"
                     Padding="8,3"/>
                                    <ToggleButton Name="Old" Checked="Old_Checked" Unchecked="Old_Unchecked" 
                     Content="🔤 От Я до А" Margin="8,0" FontSize="13"
                     Background="Transparent" BorderThickness="1" BorderBrush="#DDD"
                     Padding="8,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>


                        <!-- Фильтрация по стажу -->
                        <Border Background="#F5F5F5" CornerRadius="6" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊 " FontSize="16" VerticalAlignment="Center"/>
                                <ComboBox Name="FiltrExpert" Width="140" FontSize="13"
                                      SelectionChanged="FiltrExpert_SelectionChanged"
                                      Background="Transparent" BorderThickness="0">
                                    <ComboBoxItem>Все сотрудники</ComboBoxItem>
                                    <ComboBoxItem>Стаж 0-5 лет</ComboBoxItem>
                                    <ComboBoxItem>Стаж 5-10 лет</ComboBoxItem>
                                    <ComboBoxItem>Стаж 10+ лет</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Name="ExportReport" Click="ExportReport_Click" Content="📊 Экспорт отчета"
            Background="{StaticResource SecondaryColor}"
            FontSize="14" Height="40" Width="140" Margin="0,0,5,0"/>

                    </StackPanel>


                </Grid>
            </Border>

            <!-- Список экспертов -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ElementName=ExpertsListView, Path=ItemsSource}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Фиксированная высота карточки - 200px -->
                            <Border Background="White" CornerRadius="8"  
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                Height="200" Margin="0,0,0,5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" Opacity="0.1" ShadowDepth="1"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Увеличенное фото сотрудника -->
                                    <Border CornerRadius="8" Background="#F5F5F5" 
                                        Width="120" Height="120" Margin="0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding ExpertPhoto}" 
                                           Stretch="UniformToFill"
                                           Width="140" Height="110"/>
                                    </Border>

                                    <!-- Информация о сотруднике -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FIO}" 
           FontSize="16" FontWeight="Bold"
           Foreground="#000000"/>

                                        <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="#000000">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="👔 {0}">
                                                    <Binding Path="PositionExpert"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="#000000">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="🎂 {0:dd.MM.yyyy}">
                                                    <Binding Path="Birthday"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="#000000">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="📅 Стаж: {0} лет">
                                                    <Binding Path="Stag"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <WrapPanel Margin="0,5,0,0">
                                            <TextBlock FontSize="12" Foreground="#27AE60" Margin="0,0,15,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="📞 {0}">
                                                        <Binding Path="Phone"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="#3498DB">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="✉️ {0}">
                                                        <Binding Path="Email"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </WrapPanel>

                                        <TextBlock FontSize="12" Foreground="#E67E22" Margin="0,5,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="📊 Проведено экспертиз: {0}">
                                                    <Binding Path="ExpertsExpertise"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Кнопки действий -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" 
                                            Margin="15,0,0,0" Width="130">
                                        <Button Name="Edit" Click="Edit_Click" Content="✏️ Редактировать"
                                            Background="#3498DB" Height="35" FontSize="12"/>
                                        <Button Name="Delete" Click="Delete_Click" Content="🗑️ Удалить"
                                            Background="#E74C3C" Height="35" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Скрытый ListView для привязки данных -->
            <ListView Name="ExpertsListView" Grid.Row="1" Visibility="Collapsed"
                  IsVisibleChanged="ExpertsListView_IsVisibleChanged" 
                  SelectionChanged="ExpertsListView_SelectionChanged"/>

            <!-- Нижняя панель с счетчиком -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" 
                Padding="12" Margin="0,5,0,0">
                <TextBlock Name="Count" FontSize="13" Foreground="Gray"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Border>
        </Grid>

    </Grid>
</Page>
