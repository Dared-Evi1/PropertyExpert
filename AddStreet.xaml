<Window x:Class="Diplom.AddEditStreet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diplom"
        mc:Ignorable="d" FontFamily="Montserrat"
        Title="Добавление улицы" Height="150" Width="400"
        WindowStartupLocation="CenterOwner" Icon="/Res/icon.png"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" 
                   Text="Название улицы" 
                   FontSize="14" 
                   VerticalAlignment="Center" 
                   Margin="0,0,5,0"/>

        <TextBox Grid.Row="0" Grid.Column="1"
                 Name="NameStreet" 
                 Text="{Binding Name_Street, UpdateSourceTrigger=PropertyChanged}" 
                 FontSize="14" 
                 Height="30" 
                 MaxLength="200"
                 ToolTip="Введите название улицы"/>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,15,0,0">
            <Button Content="Сохранить" 
                    Name="SaveButton" 
                    Click="SaveButton_Click" 
                    Width="100" Height="35" Margin="5"
                    FontSize="14" IsDefault="True"/>
            <Button Content="Отмена" 
                    Name="CancelButton" 
                    Click="CancelButton_Click" 
                    Width="100" Height="35" Margin="5"
                    FontSize="14" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>