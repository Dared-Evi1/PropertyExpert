<Page x:Class="Diplom.AddEditExperts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom"
      mc:Ignorable="d" FontFamily="Montserrat"
      d:DesignHeight="550" d:DesignWidth="800"
      Title="Добавление/Редактирование Эксперта">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="Фамилия" FontSize="20" Height="25" MinWidth="120" Width="180" Margin="5" ></TextBlock>
                    <TextBox Text="{Binding Surname}" FontSize="20" Height="30"  Width="250"></TextBox>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="Имя" FontSize="20" Height="25" MinWidth="120" Width="180" Margin="5" ></TextBlock>
                    <TextBox Text="{Binding Name}" FontSize="20" Height="30"  Width="250"></TextBox>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="Отчество" FontSize="20" Height="25" MinWidth="120" Width="180" Margin="5" ></TextBlock>
                    <TextBox Text="{Binding Patronymic}" FontSize="20" Height="30"  Width="250"></TextBox>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="3" Orientation="Horizontal">
                    <TextBlock Text="Должность" FontSize="20" Height="25" MinWidth="120" Width="180" Margin="5" ></TextBlock>
                    <ComboBox SelectedValue="{Binding ID_Post}" FontSize="15" Width="250" Height="30" Name="Post" DisplayMemberPath="Post_Name"  SelectedValuePath="ID_Post"></ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="4" Orientation="Horizontal">
                    <TextBlock Text="Дата рождения" FontSize="20" Height="25" MinWidth="120" Width="180" Margin="5" ></TextBlock>
                    <DatePicker Name="Birthday" SelectedDate="{Binding Birthday}" FontSize="20" Width="250" Height="30" ></DatePicker>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="5" Orientation="Horizontal">
                    <TextBlock Text="Образование" FontSize="20" Height="25" MinWidth="120"  Width="180" Margin="5" ></TextBlock>
                    <ComboBox Name="Obrazov" Text="{Binding Education}" FontSize="20" Height="35" Width="250">
                        <TextBlock Text="Бакалавриат"></TextBlock>
                        <TextBlock Text="Специалитет"></TextBlock>
                        <TextBlock Text="Магистратура"></TextBlock>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="6" Orientation="Horizontal">
                    <TextBlock Text="Курсы" FontSize="20" Height="25" MinWidth="120"  Width="180" Margin="5" ></TextBlock>
                    <StackPanel Orientation="Vertical">
                        <RadioButton Name="Pro" GroupName="kurs" Content="Пройдены" FontSize="20" Height="30"  Width="250"></RadioButton>
                        <RadioButton Name="NePro" GroupName="kurs"  Content="Не Пройдены" FontSize="20" Height="30"  Width="250"></RadioButton>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="7" Orientation="Horizontal">
                    <TextBlock Text="Прием на работу" FontSize="20" Height="25" MinWidth="120"  Width="180" Margin="5" ></TextBlock>
                    <DatePicker Name="Date_Work" SelectedDate="{Binding Date_Work}" Width="250" FontSize="20" Height="30" ></DatePicker>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="8" Orientation="Horizontal">
                    <TextBlock Text="Телефон" FontSize="20" Height="25" MinWidth="120" Width="180" Margin="5"></TextBlock>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" 
         FontSize="20" Height="30" Width="250" 
         Name="PhoneTextBox"
         TextChanged="PhoneTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="9" Orientation="Horizontal">
                    <TextBlock Text="Email" FontSize="20" Height="25" MinWidth="120" Width="180" Margin="5"></TextBlock>
                    <TextBox Text="{Binding Email}" FontSize="20" Height="30" Width="250"></TextBox>
                </StackPanel>


                <StackPanel Grid.Column="0" Grid.Row="11" Orientation="Horizontal">
                    <TextBlock Text="Логин" FontSize="20" Height="25" MinWidth="120" Width="180" Margin="5"></TextBlock>
                    <TextBox Text="{Binding Login}" FontSize="20" Height="30" Width="250" AcceptsReturn="True"></TextBox>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="12" Orientation="Horizontal">
                    <TextBlock Text="Пароль" FontSize="20" Height="25" MinWidth="120" Width="180" Margin="5"></TextBlock>
                    <TextBox Text="{Binding Password}" FontSize="20" Height="30" Width="250" AcceptsReturn="True"></TextBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="6" Orientation="Vertical">
                    <TextBlock Text="Фотография"  FontSize="20" Height="25" MinWidth="120" Width="auto" Margin="5"></TextBlock>
                    <Image Grid.Column="1" Width="250" Height="auto" Grid.RowSpan="4" Name="ExpertImage" Grid.Row="1">
                        <Image.Source>
                            <Binding Path="ExpertPhoto" >
                                <Binding.TargetNullValue>
                                    <ImageSource>
                                        /Res/Picture.jpg
                                    </ImageSource>
                                </Binding.TargetNullValue>
                            </Binding>
                        </Image.Source>
                    </Image>
                </StackPanel>
                <Button Grid.Column="1" Grid.Row="6" Width="175" Content="Изменить" Name="ChangePicture" Click="ChangePicture_Click"></Button>
                <Button Content="Сохранить" Grid.Row="13" Width="175"  Grid.Column="0" Name="Save" Click="Save_Click"></Button>

                    
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
